<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh-Hans</string>
    <key>CFBundleDisplayName</key>
    <string>活页集 Loose-Leaf</string>
    <key>NSHumanReadableCopyright</key>
    <string>活页集 Loose-Leaf · 个人生活档案馆</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.lifestyle</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.looseleaf.mac</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>LooseLeaf</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- 关闭「突然终止」与「自动终止」：本应用依赖 applicationWillTerminate 做最后一次快照落盘，
         允许系统静默杀进程会导致用户刚录入的记录凭空消失。 -->
    <key>NSSupportsSuddenTermination</key>
    <false/>
    <key>NSSupportsAutomaticTermination</key>
    <false/>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>NSUserActivityTypes</key>
    <array>
        <string>com.looseleaf.entry</string>
    </array>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>用于在记录散页时识别当前所在城市并自动填入地点。坐标仅在本机用于省市反查，不会上传。</string>
    <key>NSLocationUsageDescription</key>
    <string>用于在记录散页时识别当前所在城市并自动填入地点。坐标仅在本机用于省市反查，不会上传。</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- 允许连接本地网络中的 http:// 数据中枢（局域网 IP）；远程部署建议改用 HTTPS。
             客户端会在「中枢与设备」页对明文 HTTP 连接给出明确风险提示。 -->
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>com.looseleaf.urlscheme</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>looseleaf</string>
            </array>
        </dict>
    </array>
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>摘录到活页集 (Loose-Leaf)</string>
            </dict>
            <key>NSMessage</key>
            <string>captureTextFromService</string>
            <key>NSPortName</key>
            <string>LooseLeaf</string>
            <key>NSSendTypes</key>
            <array>
                <string>public.utf8-plain-text</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
